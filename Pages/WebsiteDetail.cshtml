<br />
@{
    int index = 1; // Start index from 1
}

<table class="table table-bordered">
    <thead>
        <tr>
            <th style="width:50px">
                ردیف
            </th>
            <th>
               نتیجه
            </th>
            <th>تاریخ و ساعت </th>
           
            <th>تصویر </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.WebsiteInfo.WebSiteUpTimes.OrderByDescending(t=>t.ResultDate).Take(30))
{
    <tr>
                        <td>
                            @index
                        </td>
                        <td>
                            @item.Result


                        </td>
                        <td>
                            @item.ResultDate


                        </td>
                        <td>
                        @if(Model.ScreenShotExist(item.ID))
                        {
                        <a target="_blank" href=@($"screenshot/{item.ID.ToString()}.png")>مشاهده</a>
                        }
                            


                        </td>
                        </tr>

    index++;
}
    </tbody>
</table>
@section Scripts {
    <script>
        
        async function loadStatusData() {
            try {
                
                const response = await fetch(`/api/WSStatus/status?id=${@Model.WebsiteInfo.ID.ToString()}`); 
                const data = await response.json();
                
                const container = document.getElementById('LastState');
                container.innerHTML = ` ${data.lastStatus}`;
                
            } catch (error) {
                console.error('Error loading data:', error);
            }
        }

        
        loadStatusData();
    </script>
}
